# Copy to .env.local (never commit real values).

# Supabase Postgres — Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Server-only. Without it the app stores data in .data/db.json (local development only).
DATABASE_URL=

# Optional: max connections per server instance (default 5).
# DATABASE_POOL_SIZE=5

# WalletConnect / Reown project ID (free: https://cloud.reown.com). Enables QR-code and mobile wallet
# deep links. Without it, only browser-extension wallets, wallet in-app browsers and Coinbase Wallet work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Simulated payment provider: on in development, off in production unless explicitly enabled.
# ENABLE_SIMULATED_PAYMENTS=true
# SIMULATED_PAYMENTS_SECRET=change-me
