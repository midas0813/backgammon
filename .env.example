# Copy to .env.local (never commit real values). In production set these in Vercel.

# ---- Database -------------------------------------------------------------------------------------

# Supabase Postgres — Connect → "Transaction pooler" (port 6543). Server-only.
# Without it the app stores data in .data/db.json (local development only; on Vercel it refuses to run).
DATABASE_URL=

# Alternatives to DATABASE_URL, set automatically by the Vercel ↔ Supabase integration (used only
# when DATABASE_URL is empty): a full URL, or the separate parts.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_HOST=
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=postgres

# Optional: max connections per server instance (default 5).
# DATABASE_POOL_SIZE=5

# Local development without a database: where the JSON file store lives (default .data/db.json;
# ":memory:" keeps nothing between restarts).
# BG_DB_FILE=.data/db.json

# ---- Admin and jobs --------------------------------------------------------------------------------

# Admin area (/admin): comma-separated wallet addresses that become Owner on their first admin
# unlock. Only applies to wallets that never held an admin role. Further admins are added in /admin.
ADMIN_BOOTSTRAP_WALLETS=

# Protects the daily clean-up job (/api/cron/cleanup). Any long random string; Vercel Cron sends it.
CRON_SECRET=

# Anti-cheat: salt for hashing players' network addresses (they are never stored in the clear).
# Any long random string; falls back to CRON_SECRET. Changing it breaks links to older hashes.
IP_HASH_SALT=

# Discord channel webhook for error spikes and payment errors.
DISCORD_WEBHOOK_URL=

# ---- Public (sent to the browser) ------------------------------------------------------------------

# Supabase Realtime for instant match updates and chat (public values; tables stay closed by RLS).
# Supabase → Project Settings → API: Project URL and publishable key. Without them the app polls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects: the anon key works in place of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Payments --------------------------------------------------------------------------------------

# Simulated payment provider: on in development, off in production unless explicitly enabled.
# ENABLE_SIMULATED_PAYMENTS=true
# SIMULATED_PAYMENTS_SECRET=change-me

# ---- Tests only (never in production) --------------------------------------------------------------

# Browser tests (many players from one address): multiplies request limits.
# RATE_LIMIT_MULTIPLIER=20
# Unit tests against Postgres: "pglite" (in-process) or "postgres" (a real server at TEST_DATABASE_URL).
# BG_STORE=pglite
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Playwright: use the installed Chrome instead of the bundled Chromium, and add the WebKit (Safari) project.
# PW_CHANNEL=chrome
# PW_WEBKIT=1
